# SPDX-License-Identifier: GPL-3.0-or-later
"""Keep ALSA persistence, but never persist enabled MAYA phantom power.

Only edits the named control on MAYA family state blocks. No device opens,
hardware writes, shell commands, or application configuration imports.
Uses libasound's config parser, the alsactl POSIX record lock and atomic save.
"""
import argparse
import ctypes as C
import errno
import fcntl
import os
from pathlib import Path
import re
import stat
import sys
import tempfile
import time


class Config:
    def __init__(self, path):
        self.lib = C.CDLL('libasound.so.2')
        p, pp, s = C.c_void_p, C.POINTER(C.c_void_p), C.c_char_p
        signatures = {
            'snd_config_top': ([pp], C.c_int),
            'snd_config_delete': ([p], C.c_int),
            'snd_config_load': ([p, p], C.c_int),
            'snd_config_save': ([p, p], C.c_int),
            'snd_config_search': ([p, s, pp], C.c_int),
            'snd_config_get_id': ([p, C.POINTER(s)], C.c_int),
            'snd_config_get_type': ([p], C.c_int),
            'snd_config_get_string': ([p, C.POINTER(s)], C.c_int),
            'snd_config_set_string': ([p, s], C.c_int),
            'snd_config_set_integer': ([p, C.c_long], C.c_int),
            'snd_config_iterator_first': ([p], p),
            'snd_config_iterator_next': ([p], p),
            'snd_config_iterator_end': ([p], p),
            'snd_config_iterator_entry': ([p], p),
            'snd_input_stdio_open': ([pp, s, s], C.c_int),
            'snd_input_close': ([p], C.c_int),
            'snd_output_stdio_open': ([pp, s, s], C.c_int),
            'snd_output_close': ([p], C.c_int),
        }
        for name, (args, result) in signatures.items():
            fn = getattr(self.lib, name)
            fn.argtypes, fn.restype = args, result
        self.root = p()
        self.check(self.lib.snd_config_top(C.byref(self.root)))
        stream = p()
        try:
            self.check(self.lib.snd_input_stdio_open(C.byref(stream), os.fsencode(path), b'r'))
            self.check(self.lib.snd_config_load(self.root, stream))
        except BaseException:
            self.close()
            raise
        finally:
            if stream:
                self.lib.snd_input_close(stream)

    @staticmethod
    def check(result):
        if result < 0:
            raise OSError(-result, os.strerror(-result))

    def close(self):
        if self.root:
            self.lib.snd_config_delete(self.root)
            self.root = None

    def children(self, node):
        if self.lib.snd_config_get_type(node) != 1024:  # SND_CONFIG_TYPE_COMPOUND
            raise ValueError('Expected an ALSA configuration compound')
        it = self.lib.snd_config_iterator_first(node)
        end = self.lib.snd_config_iterator_end(node)
        while it != end:
            yield self.lib.snd_config_iterator_entry(it)
            it = self.lib.snd_config_iterator_next(it)

    def search(self, node, key):
        result = C.c_void_p()
        err = self.lib.snd_config_search(node, key.encode(), C.byref(result))
        if err == -errno.ENOENT:
            return None
        self.check(err)
        return result

    def string(self, node, getter='snd_config_get_string'):
        value = C.c_char_p()
        self.check(getattr(self.lib, getter)(node, C.byref(value)))
        return value.value.decode()

    def sanitize(self):
        state = self.search(self.root, 'state')
        changed = []
        if not state:
            return changed
        for card in self.children(state):
            card_id = self.string(card, 'snd_config_get_id')
            if not re.fullmatch(r'MAYA44(?:eX|XTe|e)(?:_\d+)?', card_id):
                continue
            controls = self.search(card, 'control')
            if not controls:
                continue
            for control in self.children(controls):
                name = self.search(control, 'name')
                if not name or self.string(name) != 'Mic Phantom Power Switch':
                    continue
                value = self.search(control, 'value')
                if not value:
                    raise ValueError('Phantom control is missing its value')
                text = C.c_char_p()
                if self.lib.snd_config_get_string(value, C.byref(text)) == 0:
                    if text.value.lower() in (b'false', b'off', b'0'):
                        continue
                    self.check(self.lib.snd_config_set_string(value, b'false'))
                else:
                    # ALSA also accepts a BOOLEAN represented as an integer.
                    get_int = self.lib.snd_config_get_integer
                    get_int.argtypes, get_int.restype = [C.c_void_p, C.POINTER(C.c_long)], C.c_int
                    number = C.c_long()
                    self.check(get_int(value, C.byref(number)))
                    if number.value == 0:
                        continue
                    self.check(self.lib.snd_config_set_integer(value, 0))
                changed.append(card_id)
        return changed

    def save(self, path):
        stream = C.c_void_p()
        self.check(self.lib.snd_output_stdio_open(C.byref(stream), os.fsencode(path), b'w'))
        try:
            self.check(self.lib.snd_config_save(self.root, stream))
        finally:
            self.check(self.lib.snd_output_close(stream))


def sanitize(path, lock_path):
    if not path.exists():
        return []
    # alsactl uses fcntl(F_SETLKW), bytes 0..10 of this separate lock inode.
    with open(lock_path, 'a+b') as lock:
        deadline = time.monotonic() + 3
        while True:
            try:
                fcntl.lockf(lock, fcntl.LOCK_EX | fcntl.LOCK_NB, 11, 0)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise TimeoutError('ALSA state is busy')
                time.sleep(.02)
        if not path.exists():
            return []
        metadata = path.lstat()
        if not stat.S_ISREG(metadata.st_mode):
            raise ValueError('ALSA state must be a regular file')
        config = Config(path)
        temporary = None
        try:
            changed = config.sanitize()
            if not changed:
                return []
            fd, temporary = tempfile.mkstemp(prefix='.maya44e-state-', dir=path.parent)
            os.close(fd)
            config.save(temporary)
            os.chmod(temporary, stat.S_IMODE(metadata.st_mode))
            if os.geteuid() == 0:
                os.chown(temporary, metadata.st_uid, metadata.st_gid)
            with open(temporary, 'rb') as saved:
                os.fsync(saved.fileno())
            os.replace(temporary, path)
            temporary = None
            directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
            try:
                os.fsync(directory)
            finally:
                os.close(directory)
            return changed
        finally:
            config.close()
            if temporary is not None:
                os.unlink(temporary)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--file', type=Path, default=Path('/var/lib/alsa/asound.state'))
    parser.add_argument('--lock', type=Path, default=Path('/var/lock/asound.state.lock'))
    args = parser.parse_args()
    changed = sanitize(args.file, args.lock)
    if changed:
        print('Saved phantom power disabled for ' + ', '.join(changed))


if __name__ == '__main__':
    try:
        main()
    except Exception as exc:
        print('maya44e-state: ' + str(exc), file=sys.stderr)
        sys.exit(1)
